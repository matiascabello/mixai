# OpenAI
OPENAI_API_KEY=

# Optional: override which models are used. Defaults shown below.
# OPENAI_CHAT_MODEL=gpt-5.6-terra
# OPENAI_QUICK_REPLY_MODEL=gpt-5.6-luna

# Spotify (create an app at https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must be registered exactly in the Spotify dashboard.
# Use http://127.0.0.1:3000/... for local dev (never localhost), HTTPS in production.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# Random string, 32+ characters, used to encrypt the session cookie
IRON_SESSION_PASSWORD=
